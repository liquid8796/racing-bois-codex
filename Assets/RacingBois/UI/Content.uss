.content-modal { display: none; position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgba(8,9,10,.9); align-items: center; justify-content: center; }
.content-card { width: 700px; max-width: 88%; max-height: 90%; padding: 28px; background-color: var(--ink); border-top-width: 3px; border-top-color: var(--amber); }
.content-heading { flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 16px; flex-shrink: 0; }
.content-title { font-size: 29px; color: rgb(247,241,225); -unity-font-style: bold; margin-bottom: 12px; }
.content-choice { margin: 8px 0; min-height: 44px; color: rgb(247,241,225); font-size: 16px; }
.content-choice .unity-base-field__label { width: 155px; color: var(--muted); }
.content-choice .unity-base-popup-field__input { min-height: 44px; background-color: rgb(32,34,34); color: rgb(247,241,225); border-width: 1px; border-color: var(--line); }
.content-choice:focus .unity-base-popup-field__input { border-width: 2px; border-color: var(--amber); }
#content-progress { height: 30px; margin-top: 15px; margin-bottom: 20px; }
#content-progress .unity-progress-bar__progress { background-color: var(--amber); }
#practice-open { margin-bottom: 8px; }
.compact .content-card { padding: 20px 26px; }
.compact .content-title { font-size: 25px; }
