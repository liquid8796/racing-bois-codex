    <Compile Include="VisualPoseEnvelope.cs" /><Compile Include="UnityVisualPoseEnvelope.cs" /><Compile Include="PresentationContinuityScope.cs" />
    <Reference Include="$(UnityManaged)/UnityEngine/*.dll" />
    <Reference Include="$(ProjectRoot)Library/ScriptAssemblies/RacingBois.Gameplay.Definitions.dll" />
    <Reference Include="$(ProjectRoot)Library/ScriptAssemblies/RacingBois.Simulation.dll" />
    <Reference Include="$(ProjectRoot)Library/ScriptAssemblies/RacingBois.Protocol.dll" />
    <Reference Include="$(ProjectRoot)Library/ScriptAssemblies/RacingBois.NetworkMapping.dll" />
    <Reference Include="$(ProjectRoot)Library/ScriptAssemblies/RacingBois.Golden.dll" />
    <Reference Include="$(ProjectRoot)Library/ScriptAssemblies/Unity.InputSystem.dll" />
    <Reference Include="$(ProjectRoot)Library/ScriptAssemblies/Unity.RenderPipelines.*.dll" />
  </ItemGroup>
</Project>
