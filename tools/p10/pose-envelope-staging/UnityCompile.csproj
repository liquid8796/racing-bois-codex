<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework><LangVersion>9</LangVersion><Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings><EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors><NoWarn>0436</NoWarn>
    <DefineConstants>UNITY_STANDALONE_WIN;UNITY_6000_0_OR_NEWER</DefineConstants>
    <UnityManaged>C:/Program Files/Unity/Hub/Editor/6000.5.7f1/Editor/Data/Managed</UnityManaged>
    <ProjectRoot>$(MSBuildThisFileDirectory)../../../</ProjectRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(ProjectRoot)Assets/RacingBois/Client/**/*.cs"
      Exclude="$(ProjectRoot)Assets/RacingBois/Client/Application/MultiplayerSession.cs;$(ProjectRoot)Assets/RacingBois/Client/Application/MultiplayerSession.Messages.cs;$(ProjectRoot)Assets/RacingBois/Client/Bootstrap/RaceBootstrap.cs;$(ProjectRoot)Assets/RacingBois/Client/Presentation/RaceStageView.cs" />
