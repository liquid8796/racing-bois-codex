[Unit]
Description=Racing Bois private health, backup freshness and TLS monitor
After=racing-bois-staging.service

[Service]
Type=oneshot
User=racing-bois-staging
Group=racing-bois-staging
ExecStart=/usr/bin/python3 /srv/racing-bois/ops/monitor.py
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/racing-bois-staging
MemoryMax=128M
CPUQuota=20%
