[Unit]
Description=Consistent encrypted Racing Bois staging SQLite backup
After=racing-bois-staging.service

[Service]
Type=oneshot
User=racing-bois-staging
Group=racing-bois-staging
ExecStart=/usr/bin/python3 /srv/racing-bois/ops/backup.py
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/racing-bois-staging /srv/racing-bois/backups
MemoryMax=256M
CPUQuota=30%

