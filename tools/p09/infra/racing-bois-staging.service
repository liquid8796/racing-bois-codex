[Unit]
Description=Racing Bois isolated online staging authority
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=racing-bois-staging
Group=racing-bois-staging
WorkingDirectory=/srv/racing-bois/current/server
ExecStart=/srv/racing-bois/current/server/RacingBois.Server.Host --Port 18080 --AllowLan false --EnableTls false --TrustLocalProxy true --RealmKind online --DataRoot /var/lib/racing-bois-staging/realm --WebRoot /srv/racing-bois/assets
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=DOTNET_NOLOGO=1
Environment=Logging__LogLevel__Microsoft.AspNetCore=Warning
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
UMask=0077
StateDirectory=racing-bois-staging
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/racing-bois-staging
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
MemoryHigh=1G
MemoryMax=1536M
CPUQuota=150%
TasksMax=128
LimitNOFILE=8192
StandardOutput=journal
StandardError=journal
SyslogIdentifier=racing-bois-staging

[Install]
WantedBy=multi-user.target
