    <Reference Include="$(ProjectRoot)Library/ScriptAssemblies/RacingBois.Simulation.dll" />
    <Reference Include="$(ProjectRoot)Library/ScriptAssemblies/RacingBois.Protocol.dll" />
    <Reference Include="$(ProjectRoot)Library/ScriptAssemblies/RacingBois.NetworkMapping.dll" />
  </ItemGroup>
</Project>
