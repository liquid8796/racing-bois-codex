    {
      "key": "multiplayer.room.info",
      "vi": "{players} / {capacity} NGƯỜI · {bots} MÁY\n{course} · CẤP {level}{visibility}",
      "arguments": [
        "players",
        "capacity",
        "bots",
        "course",
        "level",
        "visibility"
      ],
      "bindings": [
        {
          "file": "Assets/RacingBois/Client/Presentation/MultiplayerLobbyView.cs",
          "member": "Render",
          "sourceExpression": "room.Members.Count + \" / \" + room.MaxPlayers + \" NGƯỜI · \" + room.BotCount + \" MÁY\\n\" +\n                        CampaignCatalog.GetRoute(room.CourseIndex).DisplayName + \" · CẤP \" + (room.LevelIndex + 1) + (room.PublicRoom ? \" · CÔNG KHAI\" : \" · RIÊNG TƯ\")"
