        {
          "file": "Assets/RacingBois/Client/Presentation/MultiplayerLobbyView.cs",
          "member": "RoomLevelHint",
          "sourceExpression": "\"Hồ sơ của bạn đang ở cấp \" + (expected + 1) + \". Phòng vẫn giữ cấp \" + (session.Room.LevelIndex + 1) + \"; hãy rời phòng và tạo chặng ở cấp hiện tại.\""
