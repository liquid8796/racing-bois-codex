<Project>
 <PropertyGroup>
  <BaseIntermediateOutputPath>obj/$(MSBuildProjectName)/$(Flavor)/</BaseIntermediateOutputPath><BaseOutputPath>bin/$(MSBuildProjectName)/$(Flavor)/</BaseOutputPath>
  <TargetFramework>netstandard2.1</TargetFramework><LangVersion>9</LangVersion><EnableDefaultCompileItems>false</EnableDefaultCompileItems><Nullable>disable</Nullable><ImplicitUsings>disable</ImplicitUsings><TreatWarningsAsErrors>true</TreatWarningsAsErrors><AssemblyVersion>0.0.0.0</AssemblyVersion>
  <ProjectRoot>$(MSBuildThisFileDirectory)../../../../</ProjectRoot><UnityManaged>C:/Program Files/Unity/Hub/Editor/6000.5.7f1/Editor/Data/Managed</UnityManaged>
  <CareerCopyCandidate Condition="'$(CareerCopyCandidate)'==''">$(MSBuildThisFileDirectory)../global-copy-fit-amendment/UiText.Career.Generated.cs</CareerCopyCandidate>
  <RaceScreenCandidate Condition="'$(RaceScreenCandidate)'==''">$(ProjectRoot)Assets/RacingBois/Client/Presentation/RaceScreen.cs</RaceScreenCandidate>
  <DefineConstants Condition="'$(Flavor)'=='Editor'">UNITY_EDITOR;UNITY_STANDALONE_WIN;UNITY_6000_0_OR_NEWER</DefineConstants>
  <DefineConstants Condition="'$(Flavor)'=='Windows'">UNITY_STANDALONE_WIN;UNITY_6000_0_OR_NEWER</DefineConstants>
  <DefineConstants Condition="'$(Flavor)'=='Web'">UNITY_WEBGL;UNITY_6000_0_OR_NEWER</DefineConstants>
 </PropertyGroup>
</Project>
