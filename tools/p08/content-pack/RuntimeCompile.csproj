    <Compile Include="$(ProjectRoot)Assets/RacingBois/Client/Application/P08AudioRoles.cs" Link="P08AudioRoles.cs" />
    <Reference Include="$(UnityManaged)/UnityEngine/*.dll" />
    <Reference Include="$(UnityManaged)/UnityEditor/*.dll" />
    <Reference Include="$(ProjectRoot)Library/ScriptAssemblies/RacingBois.Authoring.Editor.dll" />
    <Reference Include="$(ProjectRoot)Library/ScriptAssemblies/RacingBois.Client.Presentation.dll" />
    <Reference Include="$(ProjectRoot)Library/ScriptAssemblies/RacingBois.Client.Application.dll" />
    <Reference Include="$(ProjectRoot)Library/ScriptAssemblies/RacingBois.Gameplay.Definitions.dll" />
    <Reference Include="$(ProjectRoot)Library/ScriptAssemblies/Unity.RenderPipelines.Universal.Runtime.dll" />
    <Reference Include="$(ProjectRoot)Library/ScriptAssemblies/Unity.RenderPipelines.Core.Runtime.dll" />
  </ItemGroup>
</Project>
