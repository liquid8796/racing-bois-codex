    <Compile Include="$(ProjectRoot)Assets/RacingBois/Client/Presentation/ContentRegistry.cs" Link="ContentRegistry.cs" />
    <Compile Include="$(ProjectRoot)Assets/RacingBois/Client/Adapters/P08ContentLoader.cs" Link="P08ContentLoader.cs" />
