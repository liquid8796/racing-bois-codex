<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework><LangVersion>9</LangVersion>
    <Nullable>disable</Nullable><ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors><NoWarn>0436</NoWarn>
    <DefineConstants>UNITY_EDITOR;UNITY_6000_0_OR_NEWER</DefineConstants>
    <UnityManaged>C:/Program Files/Unity/Hub/Editor/6000.5.7f1/Editor/Data/Managed</UnityManaged>
    <ProjectRoot>$(MSBuildThisFileDirectory)../../../</ProjectRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(ProjectRoot)Assets/RacingBois/Editor/P08ContentPackBuilder.cs" Link="P08ContentPackBuilder.cs" />
